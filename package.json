{
  "name": "bios-build-assistant",
  "displayName": "BIOS Build Assistant",
  "description": "Designed to speed up BIOS builds and eliminate repetitive manual work.",
  "version": "0.1.2",
  "publisher": "SuyuDiao",
  "icon": "media/bios.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/bios-build-helper.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "biosBuildAssistant",
          "title": "BIOS Build Assistant",
          "icon": "media/bios.png"
        }
      ]
    },
    "views": {
      "biosBuildAssistant": [
        {
          "id": "biosBuildAssistant.panel",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "biosBuildAssistant.incrementAndBuild",
        "title": "BIOS: Increment Version & Build",
        "icon": "$(repo-push)"
      },
      {
        "command": "biosBuildAssistant.testBuild",
        "title": "BIOS: TEST BIOS Build",
        "icon": "$(beaker)"
      },
      {
        "command": "biosBuildAssistant.buildOnly",
        "title": "BIOS: Build Only",
        "icon": "$(terminal)"
      },
      {
        "command": "biosBuildAssistant.svnUpdate",
        "title": "BIOS: SVN Update",
        "icon": "$(sync)"
      },
      {
        "command": "biosBuildAssistant.svnCleanRevert",
        "title": "BIOS: SVN Clean & Revert",
        "icon": "$(clear-all)"
      },
      {
        "command": "biosBuildAssistant.configurePaths",
        "title": "Configure Paths",
        "icon": "$(settings-gear)"
      },
      {
        "command": "biosBuildAssistant.addInfoField",
        "title": "Add Info Field",
        "icon": "$(add)"
      },
      {
        "command": "biosBuildAssistant.resetInfoFields",
        "title": "Reset Info Fields to Default",
        "icon": "$(discard)"
      },
      {
        "command": "biosBuildAssistant.reselectBuildFields",
        "title": "Re-select Build Fields",
        "icon": "$(gear)"
      },
      {
        "command": "biosBuildAssistant.moveItemUp",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "biosBuildAssistant.moveItemDown",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "biosBuildAssistant.removeInfoField",
        "title": "Hide Info Field",
        "icon": "$(eye-closed)"
      },
      {
        "command": "biosBuildAssistant.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "BIOS Build Assistant",
      "properties": {
        "biosBuildAssistant.defFile": {
          "type": "string",
          "default": "",
          "description": "Path to BiosVersion.def (supports ${workspaceFolder} variable)"
        },
        "biosBuildAssistant.buildBat": {
          "type": "string",
          "default": "",
          "description": "Path to build batch script (supports ${workspaceFolder} variable)"
        },
        "biosBuildAssistant.buildArgs": {
          "type": "string",
          "default": "",
          "description": "Extra arguments to pass to the build bat"
        },
        "biosBuildAssistant.dateFormat": {
          "type": "string",
          "default": "MM/DD/YYYY",
          "enum": ["MM/DD/YYYY", "DD/MM/YYYY", "YYYY-MM-DD"],
          "description": "Date format for BLD_DATE fields"
        },
        "biosBuildAssistant.incrementMajor": {
          "type": "boolean",
          "default": false,
          "description": "If true, also increment MAJOR when MINOR overflows (>= 100)"
        },
        "biosBuildAssistant.formalBuildLabel": {
          "type": "string",
          "default": "Formal BIOS Build",
          "description": "Custom label shown for the formal BIOS build action"
        },
        "biosBuildAssistant.testBuildLabel": {
          "type": "string",
          "default": "Test BIOS Build",
          "description": "Custom label shown for the test BIOS build action"
        },
        "biosBuildAssistant.buildOnlyLabel": {
          "type": "string",
          "default": "Build Only",
          "description": "Custom label shown for the build-only action"
        },
        "biosBuildAssistant.svnUpdateLabel": {
          "type": "string",
          "default": "SVN Update",
          "description": "Custom label shown for the SVN update action"
        },
        "biosBuildAssistant.svnCleanRevertLabel": {
          "type": "string",
          "default": "SVN Clean & Revert",
          "description": "Custom label shown for the SVN clean and revert action"
        },
        "biosBuildAssistant.formalBuildFields": {
          "type": "array",
          "default": [],
          "description": "Selected Config fields to update when the Formal BIOS Build action runs. This is intentionally empty by default; users must choose manually on first use."
        },
        "biosBuildAssistant.testBuildFields": {
          "type": "array",
          "default": [],
          "description": "Selected Config fields to update when the Test BIOS Build action runs. This is intentionally empty by default; users must choose manually on first use."
        },
        "biosBuildAssistant.infoFields": {
          "type": "array",
          "description": "Fields shown under 'BIOS Current Info', in display order. Each item is { label, key }, where key is a Config field name in BiosVersion.def. Drag rows in the panel to reorder; use the + button on the group title to add and the eye button on a row to hide.",
          "default": [
            { "label": "BIOS_VERSION", "key": "BIOS_VERSION" },
            { "label": "BIOS_VERSION_MAJOR", "key": "BIOS_VERSION_MAJOR" },
            { "label": "BIOS_VERSION_MINOR", "key": "BIOS_VERSION_MINOR" },
            { "label": "ACPI_OEM_REVISION", "key": "ACPI_OEM_REVISION" },
            { "label": "LENOVO_COMMON_BLD_ID", "key": "LENOVO_COMMON_BLD_ID" },
            { "label": "LENOVO_COMMON_BLD_DATE", "key": "LENOVO_COMMON_BLD_DATE" }
          ],
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "description": "Display name in the panel (same as key by default)" },
              "key": { "type": "string", "description": "Config field name in BiosVersion.def" }
            },
            "required": ["label", "key"]
          }
        },
        "biosBuildAssistant.itemOrder": {
          "type": "object",
          "description": "Display order of rows inside each group, changed by dragging rows in the panel. paths: defFile/buildBat; actions: incBuild/testBuild/buildOnly; svnops: svnUpdate/svnCleanRevert.",
          "default": {
            "paths": ["defFile", "buildBat"],
            "actions": ["incBuild", "testBuild", "buildOnly"],
            "svnops": ["svnUpdate", "svnCleanRevert"]
          },
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "when": "resourceFilename == BiosVersion.def",
          "command": "biosBuildAssistant.incrementAndBuild",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "biosBuildAssistant.configurePaths",
          "when": "view == biosBuildAssistant.panel",
          "group": "navigation@1"
        },
        {
          "command": "biosBuildAssistant.refresh",
          "when": "view == biosBuildAssistant.panel",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "biosBuildAssistant.reselectBuildFields",
          "when": "view == biosBuildAssistant.panel && viewItem == actionWithConfig",
          "group": "inline@1"
        },
        {
          "command": "biosBuildAssistant.buildOnly",
          "when": "view == biosBuildAssistant.panel && viewItem == actionBuildOnly",
          "group": "inline@1"
        },
        {
          "command": "biosBuildAssistant.svnUpdate",
          "when": "view == biosBuildAssistant.panel && viewItem == actionSvnUpdate",
          "group": "inline@1"
        },
        {
          "command": "biosBuildAssistant.svnCleanRevert",
          "when": "view == biosBuildAssistant.panel && viewItem == actionSvnCleanRevert",
          "group": "inline@1"
        },
        {
          "command": "biosBuildAssistant.addInfoField",
          "when": "view == biosBuildAssistant.panel && viewItem == versionGroup",
          "group": "inline@1"
        },
        {
          "command": "biosBuildAssistant.resetInfoFields",
          "when": "view == biosBuildAssistant.panel && viewItem == versionGroup",
          "group": "inline@2"
        },
        {
          "command": "biosBuildAssistant.removeInfoField",
          "when": "view == biosBuildAssistant.panel && viewItem == infoField",
          "group": "inline@1"
        },
        {
          "command": "biosBuildAssistant.moveItemUp",
          "when": "view == biosBuildAssistant.panel && viewItem =~ /^(pathItem|infoField|action)$/",
          "group": "1_order@1"
        },
        {
          "command": "biosBuildAssistant.moveItemDown",
          "when": "view == biosBuildAssistant.panel && viewItem =~ /^(pathItem|infoField|action)$/",
          "group": "1_order@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}


